---
import { Picture } from "astro:assets";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import RRSS from "@components/RRSS.astro";

// ✅ Ya no hace fetchs, recibe todo por props
const { headerData, categories, rrssData, currentCategory, headerLinks = [] } = Astro.props;
const { lang, slug } = Astro.params;

const imageUrl = headerData.imageUrl || "";
const imageAlt = headerData.imageAlt || "Logo Vibria";

// Separar los enlaces por tipo para fácil acceso
const contacteLink = headerLinks.find(link => link.slug.includes('contacte'));
const assessoriesLink = headerLinks.find(link => link.slug.includes('assessories'));
const tiendaLink = headerLinks.find(link => link.slug.includes('tienda'));

const currentPath = Astro.url.pathname;
const isInAssessories = assessoriesLink && currentPath.includes(assessoriesLink.slug.replace(/^\//, ''));

const lastSegment = slug?.toLowerCase() ?? "";

const categoryColors = {
  "La Víbria": { text: "text-secondary", border: "border-secondary" },
  "The Vibria": { text: "text-secondary", border: "border-secondary" },
  "Voluntariado Europeo": { text: "text-red", border: "border-red" },
  "Voluntariat Europeu": { text: "text-red", border: "border-red" },
  "European volunteering": { text: "text-red", border: "border-red" },
  "Erasmus+": { text: "text-blue", border: "border-blue" },
  "Prácticas Internacionales": { text: "text-yellow", border: "border-yellow" },
  "Pràctiques Internacionals": { text: "text-yellow", border: "border-yellow" },
  "International practices": { text: "text-yellow", border: "border-yellow" },
  "Proyectos Internacionales": { text: "text-orange", border: "border-orange" },
  "Projectes Internacionals": { text: "text-orange", border: "border-orange" },
  "International Projects": { text: "text-orange", border: "border-orange" },
  "Proyectos Locales": { text: "text-pink", border: "border-pink" },
  "Projectes Locals": { text: "text-pink", border: "border-pink" },
  "Local Projects": { text: "text-pink", border: "border-pink" },
};

const currentCategoryColors = categoryColors[currentCategory] ?? {
  text: "",
  border: "border-secondary",
};

const sectionsToRender = categories.parent?.length > 0
  ? categories.parent.map((parent) => ({
      title: parent.title,
      items: categories.children[parent.id]?.map((child) => child.title) || [],
      links: categories.children[parent.id]?.map((child) => `/${lang}/${child.slug}`) || [],
    }))
  : [];
---

<!-- MOBILE VERSION -->
<div class="sticky top-0 z-30 md:hidden">
  <header class="flex items-center justify-between bg-primary px-4 py-2 z-10">
    <a id="menu-toggle" class="flex justify-start min-w-[90px] z-10 cursor-pointer">
      <img id=menu-icon src="/iconos/menu.svg" alt="Menu" class="w-8 h-8" />
      <span id="close-icon" class="hidden justify-center text-[2.5rem] text-white">×</span>
    </a>

    <a href={`/${lang}/home`} class="z-10">
      {imageUrl && <img src={imageUrl} alt={imageAlt} class="w-[60px] h-[60px]" />}
    </a>

    <LanguageSwitcher currentLang={lang} class="z-10" />
  </header>

  <div
    id="menu"
    class="grid grid-rows-[auto_1fr_auto_auto] fixed inset-0 mt-[4.5rem] bg-white pt-0 z-10 shadow-lg overflow-y-auto transition-all duration-300 -translate-y-5 opacity-0 invisible"
  >
    <div class="bg-yellow text-white text-center font-medium px-4 py-2">
      <div class="flex justify-between items-center">
        <a href={contacteLink?.slug || "#"} class="text-lg text-start min-w-[90px] gap-1">
          {contacteLink?.title || "Contacte"}
        </a>
        <a
          href={assessoriesLink?.slug || "#"}
          class="px-4 py-1 border-2 border-white rounded-full font-bold tracking-wide"
        >
          {assessoriesLink?.title?.toUpperCase() || "ASSESSORIES"}
        </a>
        <a href={tiendaLink?.slug || "#"} class="text-lg text-end min-w-[90px] gap-1">
          {tiendaLink?.title || "Tienda"}
        </a>
      </div>
    </div>
    
    <div class="flex flex-col justify-center w-full max-w-2xl mx-auto">
      {sectionsToRender.map((section, index) => (
        <div class="border-b border-gray-200">
          <div
            class="flex items-center py-6 px-4 cursor-pointer accordion-header"
            data-index={index}
          >
            <span class="w-full text-center text-lg font-bold text-[#058279]">
              {section.title}
            </span>
            {section.items.length > 0 && (
              <img
                class="w-5 h-5 transition-transform duration-300 accordion-icon"
                src="/images/flecha-abajo.png"
                alt="Flecha"
                data-open="false"
              />
            )}
          </div>
          {section.items.length > 0 && (
            <div class="max-h-0 p-0 overflow-hidden transition-[max-height] duration-300 -mx-5">
              {section.items.map((item, itemIndex) => (
                <a
                  href={section.links[itemIndex]}
                  class="border-b border-white block py-2 text-white text-center bg-[#5DC695] font-bold"
                >
                  {item}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
    
    <div class="bg-yellow text-white text-center font-bold text-lg py-2">
      Sigues voluntari/a local
    </div>
    
    <RRSS rrssData={rrssData} />
  </div>
</div>

<!-- DESKTOP VERSION -->
<div class="hidden md:block md:sticky md:top-0 md:z-30">
  <header class="bg-[#058279] flex justify-between items-center px-6 py-4">
    <a class="flex flex-row items-center justify-center gap-4" href={`/${lang}/home`}>
      {imageUrl && <img src={imageUrl} alt={imageAlt} class="w-[80px] h-[80px]" />}
      <p class="h3 font-800">La Víbria Intercultural</p>
    </a>

    <div class="flex items-center gap-2 lg:gap-4">
        <a
            class={`text-base font-700 px-2 py-0.5 border border-white rounded-full ${isInAssessories ? 'bg-white text-primary' : 'text-white bg-transparent'}`}
            href={assessoriesLink?.slug || "#"}
        >
            {assessoriesLink?.title || "Assessories"}
        </a>
        <a class="text-white text-base font-400 px-2 py-0.5" href={contacteLink?.slug || "#"}>
            {contacteLink?.title || "Contacte"}
        </a>
        <a class="text-white text-base font-400 px-2 py-0.5" href={tiendaLink?.slug || "#"}>
            {tiendaLink?.title || "Tienda"}
        </a>
        <LanguageSwitcher currentLang={lang} class="z-10" />
    </div>
  </header>

  <nav class="flex flex-row justify-between gap-2 bg-white text-primary text-sm font-semibold items-center p-4 lg:px-6">
    {sectionsToRender.map((section, idx) => (
      <div class="relative">
        <div
          class="flex items-center gap-1 cursor-pointer text-[11px] font-500 lg:text-[15px] lg:font-700 dropdown-toggle"
          data-index={idx}
        >
          <span
            class={`${section.title === currentCategory ? currentCategoryColors.text : "text-[#058279]"}`}
          >
            {section.title}
          </span>
          {section.items.length > 0 && (
            <img
              src="/images/flecha-abajo.png"
              alt="Flecha"
              class={`w-3.5 h-3.5 lg:w-4 lg:h-4 transform transition-transform duration-200 ${
                section.title === currentCategory ? "rotate-180" : ""
              }`}
              data-open="false"
            />
          )}
        </div>
        {section.items.length > 0 && (
          <div
            class="absolute top-8 -left-6 bg-secondary text-white text-center min-w-[125px] opacity-0 invisible transition-all duration-200 z-40 lg:top-10 lg:min-w-[150px] dropdown-menu"
            data-index={idx}
          >
            {section.items.map((item, idx2) => (
              <a
                href={section.links[idx2]}
                class="block px-4 py-2 border-t border-t-white hover:underline"
              >
                {item}
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
  </nav>
</div>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    function initMenu() {
      const toggleBtn = document.querySelector("#menu-toggle");
      const menu = document.querySelector("#menu");
      const closeIcon = document.querySelector("#close-icon");

      toggleBtn?.addEventListener("click", () => {
        menu?.classList.toggle("translate-y-0");
        menu?.classList.toggle("opacity-100");
        menu?.classList.toggle("visible");
        menu?.classList.toggle("-translate-y-5");
        menu?.classList.toggle("opacity-0");
        menu?.classList.toggle("invisible");
        toggleBtn.querySelector("img")?.classList.toggle("hidden");
        closeIcon?.classList.toggle("hidden");
        document.body.classList.toggle("overflow-hidden");
      });

      document.querySelectorAll(".accordion-header").forEach((header) => {
        header.addEventListener("click", () => {
          const content = header.nextElementSibling;
          const icon = header.querySelector(".accordion-icon");
          content?.classList.toggle("max-h-[500px]");
          const isOpen = icon?.getAttribute("data-open") === "true";
          if (icon) {
            icon.src = isOpen ? "/images/flecha-abajo.png" : "/images/flecha-arriba.png";
            icon.setAttribute("data-open", isOpen ? "false" : "true");
          }
        });
      });
    }

    function initDesktopDropdowns() {
      document.querySelectorAll(".dropdown-toggle").forEach((toggle) => {
        toggle.addEventListener("click", (e) => {
          e.stopPropagation();
          const index = toggle.dataset.index;
          const menu = document.querySelector(`.dropdown-menu[data-index="${index}"]`);
          const icon = toggle.querySelector("img");

          document.querySelectorAll(".dropdown-menu").forEach((m) => {
            if (m !== menu) {
              m.classList.add("opacity-0", "invisible");
              m.classList.remove("opacity-100", "visible");
            }
          });

          document.querySelectorAll(".dropdown-toggle img").forEach((i) => {
            if (i !== icon) i.classList.remove("rotate-180");
          });

          const isOpen = menu?.classList.contains("opacity-100");
          if (menu) {
            menu.classList.toggle("opacity-100", !isOpen);
            menu.classList.toggle("visible", !isOpen);
            menu.classList.toggle("opacity-0", isOpen);
            menu.classList.toggle("invisible", isOpen);
          }

          if (icon) icon.classList.toggle("rotate-180", !isOpen);
        });
      });

      document.addEventListener("click", (e) => {
        const isClickInside = e.target.closest(".dropdown-toggle") || e.target.closest(".dropdown-menu");
        if (!isClickInside) {
          document.querySelectorAll(".dropdown-menu").forEach((menu) => {
            menu.classList.add("opacity-0", "invisible");
            menu.classList.remove("opacity-100", "visible");
          });
          document.querySelectorAll(".dropdown-toggle img").forEach((icon) => {
            icon.classList.remove("rotate-180");
          });
        }
      });
    }

    initMenu();
    initDesktopDropdowns();
  });
</script>
---
import CategoryNav from "@components/CategoryNav.astro";
import "@styles/qui-som-content.css";

const { pageData, typeSpecificData, globalData } = Astro.props;
const { content: pageContent } = pageData;
const { teamMembers } = typeSpecificData;
const { categories } = globalData;
const { lang, slug } = Astro.params;
---

<CategoryNav lang={lang} slug={slug} categories={categories} />

<article class="max-w-4xl mx-auto bg-white p-4 space-y-8 md:mx-[15%]">
  <!-- Contenido principal de la página -->
  {pageContent && 
    <div class="qui-som page-content prose max-w-none" set:html={pageContent}></div>
  }

  <!-- Grid de miembros del equipo -->
  {teamMembers.length > 0 && (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
      {teamMembers.map((member, index) => (
        <div key={index} class="bg-gray-50 p-4 rounded-lg shadow-sm hover:shadow-md transition-shadow">
          <div class="content-item" set:html={member}></div>
        </div>
      ))}
    </div>
  )}
</article>
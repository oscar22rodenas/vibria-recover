---
import { Picture } from "astro:assets";
import CategoryNav from "@components/CategoryNav.astro";
import "@styles/oferta-content.css";

const { lang, slug } = Astro.params;
const { globalData, pageData, detailedData } = Astro.props;

// Use detailedData for the specific oferta
const oferta = detailedData;
const { categories } = globalData;
---

<CategoryNav lang={lang} slug={slug} categories={categories} />

<article class="mx-auto bg-white p-4 space-y-4 md:px-12 lg:px-16 xl:px-20 md:mx-[15%]">
  <h1 class="text-2xl font-700 text-center md:text-3xl">{oferta.title}</h1>

  <div class="md:columns-2 md:gap-8">
    {oferta.imageUrl && <Picture
      formats={["webp", "avif", "jpeg"]}
      src={oferta.imageUrl}
      alt={oferta.imageAlt}
      width="300"
      height="118"
      class="mx-auto"
    />}

    <div class="flex items-center gap-2 text-sm mt-2">
      <Picture
        formats={["webp", "avif", "jpeg"]}
        src="/iconos/Ubicacion_Rojo.png"
        alt="Ubicacion Icon"
        width="24"
        height="24"
      />
      <span class="text-black font-600">{oferta.ubicacion}</span>
    </div>

    <div class="flex items-center gap-2 text-sm mt-2">
      <Picture
        formats={["webp", "avif", "jpeg"]}
        src="/iconos/Reloj_Arena_Rojo.png"
        alt="Tiempo Icon"
        width="24"
        height="24"
      />
      <span class="text-black font-600">{oferta.fechas}</span>
    </div>

    <div class="oferta-content" set:html={pageData.content} />
  </div>
  <div class="flex items-center justify-center mt-4">
    <a
      href={oferta.buttonUrl}
      class="bg-red text-white font-700 py-1 px-2 before:text-center rounded-3xl shadow-[0_2px_4px_0_px_rgba(0,0,0,0.25)]"
    >
      {oferta.buttonText}
    </a>
  </div>
</article>

---
import CategoryNav from "@components/CategoryNav.astro";
import "@styles/diaris-voluntaris-content.css";

const { pageData, typeSpecificData, globalData } = Astro.props;
const { diaris = [], anys = [] } = typeSpecificData;
const { categories } = globalData;
const { lang, slug } = Astro.params;
---

<CategoryNav lang={lang} slug={slug} categories={categories} />

<main class="md:ml-[20%] md:pr-[10%] pt-0 px-4 pb-4 md:pt-[50px]">
  <div class="flex flex-col gap-8">
    <div class="md:fixed md:left-5 md:w-[15%] md:top-[500px] z-10">      
      <ul id="years-nav" class="custom-scrollbar flex md:flex-col gap-5 md:gap-2 pr-2 md:px-0 py-2 md:py-0 bg-white md:bg-transparent overflow-x-auto md:overflow-y-auto md:max-h-[30vh] whitespace-nowrap md:whitespace-normal border-b md:border-b-0 border-gray-100 md:border-l-2 md:border-[#D3133A] md:pl-4">        {anys.map((any) => (
          <li>
            <a 
              href={`/${lang}/${slug}?any=${any.slug}`}
              class="any-link text-sm relative pb-2 md:pb-0 block transition-colors text-gray-500 hover:text-red font-medium uppercase tracking-tight"
              data-slug={any.slug}
            >
              {any.name}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="voluntaris-content mb-4" set:html={pageData.content} />

    <div id="diaris-grid" class="grid grid-cols-2 lg:grid-cols-3 gap-4 md:gap-8">
      {diaris.map((diari) => {
        const imageUrl = diari._embedded?.['wp:featuredmedia']?.[0]?.source_url;
        const imageAlt = diari._embedded?.['wp:featuredmedia']?.[0]?.alt_text || diari.title.rendered;

        return (
          <div 
            class="diari-card flex flex-col bg-white shadow-lg hover:shadow-2xl transition-all duration-500 border border-gray-100 group"
            data-years={JSON.stringify(diari.anys)}
          >
            <a href={`/${lang}/diari/${diari.slug}`} class="block h-full">
              <div class="aspect-square overflow-hidden bg-white flex items-center justify-center"> 
                {imageUrl ? (
                  <img src={imageUrl} alt={imageAlt} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                ) : (
                  <div class="text-gray-300 italic">Sense portada</div>
                )}
              </div>
            </a>
          </div>
        );
      })}
    </div>
  </div>
</main>
<script is:inline define:vars={{ anys }}>
  function filterByYear() {
    const url = new URL(window.location);
    let selectedSlug = url.searchParams.get("any");

    if (!selectedSlug && anys.length > 0) {
      selectedSlug = anys[0].slug;
      url.searchParams.set("any", selectedSlug);
      window.history.replaceState({}, '', url);
    }

    if (selectedSlug) {
      const selectedAnyObj = anys.find(a => a.slug === selectedSlug);

      document.querySelectorAll(".any-link").forEach(link => {
        const isDesktop = window.innerWidth >= 768;
        link.classList.remove("font-bold", "text-black", "text-red", "border-l-4", "border-b-4", "border-red", "pl-2", "-ml-[18px]", "pb-1");
        link.classList.add("text-gray-500");

        if (link.dataset.slug === selectedSlug) {
          link.classList.add("font-bold", "text-black");
          link.classList.remove("text-gray-500");
          if (isDesktop) {
            link.classList.add("border-l-4", "border-red", "pl-2", "-ml-[18px]");
          } else {
            link.classList.add("border-b-4", "border-red", "pb-1", "text-red");
            link.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          }
        }
      });

      const cards = document.querySelectorAll(".diari-card");
      cards.forEach(card => {
        const cardYears = JSON.parse(card.dataset.years || "[]");
        card.style.display = cardYears.includes(selectedAnyObj?.id) ? "flex" : "none";
      });
    }
  }
  
  filterByYear();
  window.addEventListener('popstate', filterByYear);
  window.addEventListener('resize', filterByYear);
</script>
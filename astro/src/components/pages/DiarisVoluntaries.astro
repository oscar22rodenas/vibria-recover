---
import CategoryNav from "@components/CategoryNav.astro";
import "@styles/experiencies-content.css";

const { pageData, typeSpecificData, globalData } = Astro.props;
const { diaris = [], anys = [] } = typeSpecificData;
const { categories } = globalData;
const { lang, slug } = Astro.params;
---

<CategoryNav lang={lang} slug={slug} categories={categories} />

<article class="mx-auto bg-white p-4 space-y-4 md:mx-[15%] flex flex-col md:flex-row gap-8">
  <aside class="w-full md:w-48 shrink-0">
    <h3 class="font-bold mb-4 uppercase text-sm tracking-widest text-red">Anys</h3>
    <ul class="space-y-2 border-l-2 border-gray-100 pl-4">
      {anys.map((any) => (
        <li>
          <a 
            href={`/${lang}/${slug}?any=${any.slug}`}
            class="any-link text-sm block hover:text-red transition-colors text-gray-500"
            data-slug={any.slug}
          >
            {any.name}
          </a>
        </li>
      ))}
    </ul>
  </aside>

  <div class="flex-1">
    <div class="mb-6">
      <h2 id="year-title" class="text-2xl font-bold text-gray-800 uppercase">
        Diaris de Voluntàries
      </h2>
    </div>

    <div class="experiencies-content mb-8" set:html={pageData.content} />

    <div id="diaris-grid" class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {diaris.map((diari) => {
        const imageUrl = diari._embedded?.['wp:featuredmedia']?.[0]?.source_url;
        const imageAlt = diari._embedded?.['wp:featuredmedia']?.[0]?.alt_text || diari.title.rendered;

        return (
          <div 
            class="diari-card flex flex-col bg-white shadow-[0_4px_4px_rgba(0,0,0,0.25)]"
            data-years={JSON.stringify(diari.anys)}
          >
            <a href={`/${lang}/diari/${diari.slug}`} class="block">
              {imageUrl ? (
                <img src={imageUrl} alt={imageAlt} class="w-full h-64 object-cover border-b-4" />
              ) : (
                <div class="w-full h-64 bg-gray-200 flex items-center justify-center text-gray-400">Sense portada</div>
              )}
            </a>
          </div>
        );
      })}
    </div>
  </div>
</article>

<script is:inline define:vars={{ anys }}>
  function filterByYear() {
    const url = new URL(window.location);
    let selectedSlug = url.searchParams.get("any");

    if (!selectedSlug && anys.length > 0) {
      selectedSlug = anys[0].slug;
      url.searchParams.set("any", selectedSlug);
      window.history.replaceState({}, '', url);
    }

    if (selectedSlug) {
      const selectedAnyObj = anys.find(a => a.slug === selectedSlug);
      const selectedId = selectedAnyObj?.id;

      const titleEl = document.getElementById("year-title");
      if (titleEl && selectedAnyObj) titleEl.innerText = `Diaris del curs ${selectedAnyObj.name}`;

      document.querySelectorAll(".any-link").forEach(link => {
        if (link.dataset.slug === selectedSlug) {
          link.classList.add("text-red", "font-bold", "underline");
          link.classList.remove("text-gray-500");
        } else {
          link.classList.remove("text-red", "font-bold", "underline");
          link.classList.add("text-gray-500");
        }
      });

      const cards = document.querySelectorAll(".diari-card");
      cards.forEach(card => {
        const cardYears = JSON.parse(card.dataset.years || "[]");
        if (cardYears.includes(selectedId)) {
          card.style.display = "block";
        } else {
          card.style.display = "none";
        }
      });
    }
  }

  filterByYear();

  window.addEventListener('popstate', filterByYear);
</script>
---
import CategoryNav from "@components/CategoryNav.astro";
import "@styles/volunteer-content.css";

const { pageData, typeSpecificData, globalData } = Astro.props;
const { cards = [], acf = {} } = typeSpecificData;
const { categories } = globalData;
const { lang, slug } = Astro.params;
---

<CategoryNav lang={lang} slug={slug} categories={categories} />

<article class="mx-auto bg-white p-4 space-y-4 md:mx-[15%]">
    <div class="volunteer-content">
        {acf.volunteer_titulo && <h2>{acf.volunteer_titulo}</h2>}
        {acf.volunteer_texto && <p>{acf.volunteer_texto}</p>}

        <div class="general-wrapper-images">
            {/* Sección de tarjetas del CPT */}
            <div class="wrapper-images-1">
                {acf.volunteer_subtitulo_1 && <strong>{acf.volunteer_subtitulo_1}</strong>}
                {cards.slice(0, 3).map(card => (
                    <figure>
                        <a href={card.link}>
                            <img src={card.imageUrl} alt={card.imageAlt} />
                        </a>
                    </figure>
                ))}
            </div>

            <div class="wrapper-images-2">
                {acf.volunteer_subtitulo_2 && <strong>{acf.volunteer_subtitulo_2}</strong>}
                {cards.slice(3, 6).map(card => (
                    <figure>
                        <a href={card.link}>
                            <img src={card.imageUrl} alt={card.imageAlt} />
                        </a>
                    </figure>
                ))}
            </div>
        </div>

        {/* Sección de Video y Texto Final (Content) */}
        <div class="general-wrapper-text">
            {/* Contenedor de origen oculto para que el script lo procese */}
            <div id="content-source" set:html={pageData.content} style="display: none;"></div>
            
            {/* Botón final que se moverá dentro del text-wrapper */}
            {acf.volunteer_boton_link && (
                <div id="button-source" class="link-wrapper" style="display: none;">
                    <a href={acf.volunteer_boton_link}>
                        {acf.volunteer_boton_texto || 'Més informació'}
                    </a>
                </div>
            )}
        </div>
    </div>
</article>

<script is:inline>
  const wrapper = document.querySelector('.general-wrapper-text');
  const source = document.getElementById('content-source');
  const buttonSource = document.getElementById('button-source');

  if (wrapper && source) {
    // 1. Extraer el video (figure) y los párrafos (p)
    const videoFigure = source.querySelector('figure');
    const paragraphs = Array.from(source.querySelectorAll('p'));

    // 2. Crear el text-wrapper para agrupar texto y link (Columna 2)
    const textWrapper = document.createElement('div');
    textWrapper.className = 'text-wrapper';

    paragraphs.forEach(p => {
        textWrapper.appendChild(p);
    });

    // Añadir el botón al final del bloque de texto
    if (buttonSource) {
        buttonSource.style.display = 'flex';
        textWrapper.appendChild(buttonSource);
    }

    // 3. Reconstruir el wrapper con la estructura de 2 columnas (Video | Texto)
    wrapper.innerHTML = '';
    
    if (videoFigure) {
        wrapper.appendChild(videoFigure);
    }
    
    wrapper.appendChild(textWrapper);
  }
</script>

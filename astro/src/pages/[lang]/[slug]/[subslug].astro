---
// src/pages/[lang]/[slug]/[subslug].astro
import { extractLang } from "@wp/extractLang.js";
import { 
    getOfertaDetalladaInfo,
    getExperienciaDetalladaInfo,
    getDiariDetalladaInfo
} from "@wp/index.js";
import { getGlobalData, getAllPages } from "@wp/sharedBuildData.js";
import Layout from "@layouts/Layout.astro";
import OfertaDetallada from "@components/pages/OfertaDetallada.astro";
import ExperienciaDetallada from "@components/pages/ExperienciaDetallada.astro";
import DiariDetallada from "@components/pages/DiariDetallada.astro";

export async function getStaticPaths() {
    const languages = ["ca", "es", "en"];
    const globalData = await getGlobalData();
    console.log(`✅ [${Date.now() - startTime}ms] Global data ready`);
    
    // ============================================
    // ✅ OPTIMIZACIÓN 3: Páginas cacheadas
    // ============================================
    const allPages = await getAllPages();
    
    // ✅ FILTRAR: Solo páginas CON categoría (van a [subslug])
    const detailedPages = allPages.filter(page => page.acf?.categoria);
    console.log(`✅ [${Date.now() - startTime}ms] Found ${detailedPages.length} detailed pages`);
    
    // ============================================
    // PASO 3: Fetchear datos detallados por idioma
    // ============================================
    console.log(`⏱️  [${Date.now() - startTime}ms] Processing detailed data for each page...`);
    
    const pathsPromises = detailedPages.map(async (page) => {
        const extracted = extractLang(page.slug);
        if (!extracted || !languages.includes(extracted.lang)) {
            return null;
        }
        
        const { lang, baseSlug } = extracted;
        const categoria = page.acf.categoria;
        const slugCompleto = page.slug;
        
        let detailedData = null;
        const pageStartTime = Date.now();
        
        try {
            if (categoria === 'ofertes') {
                console.log(`⏱️  [${Date.now() - startTime}ms] Fetching oferta [${lang}]: ${baseSlug}`);
                detailedData = await getOfertaDetalladaInfo(slugCompleto);
                console.log(`✅ [${Date.now() - startTime}ms] Oferta ${baseSlug} [${lang}] done (${Date.now() - pageStartTime}ms)`);
            } else if (categoria === 'experiencies') {
                console.log(`⏱️  [${Date.now() - startTime}ms] Fetching experiencia [${lang}]: ${baseSlug}`);
                detailedData = await getExperienciaDetalladaInfo(slugCompleto);
                console.log(`✅ [${Date.now() - startTime}ms] Experiencia ${baseSlug} [${lang}] done (${Date.now() - pageStartTime}ms)`);
            } else if (categoria === 'diaris-voluntaries') {
                console.log(`⏱️  [${Date.now() - startTime}ms] Fetching diari [${lang}]: ${baseSlug}`);
                detailedData = await getDiariDetalladaInfo(slugCompleto);
                console.log(`✅ [${Date.now() - startTime}ms] Diari ${baseSlug} [${lang}] done (${Date.now() - pageStartTime}ms)`);
            } else {
                console.warn(`⚠️  [${Date.now() - startTime}ms] Unknown category '${categoria}' for page ${slugCompleto} [${lang}]`);
            }
        } catch (error) {
            console.error(`❌ [${Date.now() - startTime}ms] Error fetching ${categoria}/${baseSlug} [${lang}]:`, error.message);
        }
        
        return {
            params: { 
                lang, 
                slug: categoria, 
                subslug: baseSlug 
            },
            props: {
                globalData: globalData[lang],
                pageData: { 
                    acf: { categoria: 'diari' }, 
                    content: diari.content.rendered 
                },
                detailedData: diariData // Pasamos los datos ya listos
            }
        }));
    });

    const pagesResults = await Promise.all(pagePathsPromises);
    return [...pagesResults.filter(Boolean), ...diariPaths];
}

const { globalData, pageData, detailedData: initialData } = Astro.props;
const { subslug, slug } = Astro.params;

// detailedData ya vendrá de las props gracias al cambio anterior
let detailedData = initialData;

// Fallback de seguridad (solo se ejecutará en modo dev si algo falta)
if (!detailedData && slug === 'diari') {
    detailedData = await getDiariDetallatInfo(subslug);
}

let PageComponent;
switch (slug) {
    case "ofertes":
        PageComponent = OfertaDetallada;
        break;
    case "experiencies":
        PageComponent = ExperienciaDetallada;
        break;
    case "diaris-voluntaries":
        PageComponent = DiariDetallada;
        break;
    default:
        break;
}
---
<Layout globalData={globalData}>
    {PageComponent ? (
        <PageComponent 
            pageData={pageData} 
            detailedData={detailedData} 
            globalData={globalData} 
        />
    ) : (
        <div>Page not found</div>
    )}
</Layout>
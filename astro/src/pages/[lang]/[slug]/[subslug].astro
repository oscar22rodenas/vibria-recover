---
// src/pages/[lang]/[slug]/[subslug].astro
import { extractLang } from "@wp/extractLang.js";
import { 
    getOfertaDetalladaInfo,
    getExperienciaDetalladaInfo,
    getDiariDetallatInfo
} from "@wp/index.js";
import { getGlobalData, getAllPages } from "@wp/sharedBuildData.js";
import Layout from "@layouts/Layout.astro";
import OfertaDetallada from "@components/pages/OfertaDetallada.astro";
import ExperienciaDetallada from "@components/pages/ExperienciaDetallada.astro";
import DiariDetallat from "@components/pages/DiariDetallat.astro";

export async function getStaticPaths() {
    const languages = ["ca", "es", "en"];
    const globalData = await getGlobalData();
    const allPages = await getAllPages(); 

    // 1. Obtener diarios con _embed para traer imágenes y evitar fetch individuales después
    const responseDiaris = await fetch(`http://localhost:8000/wp-json/wp/v2/diaris?_embed&_fields=slug,title,content,_embedded`);
    const allDiaris = await responseDiaris.json();

    // 2. Procesar páginas normales (Ofertas y Experiencias)
    const pagePathsPromises = allPages
        .filter(page => page.acf?.categoria)
        .map(async (page) => {
            const extracted = extractLang(page.slug);
            if (!extracted || !languages.includes(extracted.lang)) return null;
            
            const { lang, baseSlug } = extracted;
            const categoria = page.acf.categoria;
            
            let detailedData = null;
            if (categoria === 'ofertes') detailedData = await getOfertaDetalladaInfo(page.slug);
            else if (categoria === 'experiencies') detailedData = await getExperienciaDetalladaInfo(page.slug);

            return {
                params: { lang, slug: categoria, subslug: baseSlug },
                props: {
                    globalData: globalData[lang],
                    pageData: { acf: page.acf, content: page.content?.rendered || "" },
                    detailedData
                }
            };
        });

    // 3. Generar rutas para Diarios INYECTANDO los datos (Optimizado para Build rápido)
    const diariPaths = allDiaris.flatMap((diari) => {
        // Pre-procesamos el objeto de datos del diario aquí
        const diariData = {
            title: diari.title.rendered,
            content: diari.content.rendered,
            imageUrl: diari._embedded?.['wp:featuredmedia']?.[0]?.source_url || null,
            imageAlt: diari._embedded?.['wp:featuredmedia']?.[0]?.alt_text || diari.title.rendered
        };

        return languages.map(lang => ({
            params: { lang, slug: 'diari', subslug: diari.slug },
            props: {
                globalData: globalData[lang],
                pageData: { 
                    acf: { categoria: 'diari' }, 
                    content: diari.content.rendered 
                },
                detailedData: diariData // Pasamos los datos ya listos
            }
        }));
    });

    const pagesResults = await Promise.all(pagePathsPromises);
    return [...pagesResults.filter(Boolean), ...diariPaths];
}

const { globalData, pageData, detailedData: initialData } = Astro.props;
const { subslug, slug } = Astro.params;

// detailedData ya vendrá de las props gracias al cambio anterior
let detailedData = initialData;

// Fallback de seguridad (solo se ejecutará en modo dev si algo falta)
if (!detailedData && slug === 'diari') {
    detailedData = await getDiariDetallatInfo(subslug);
}

let PageComponent;
switch (slug) {
    case "ofertes":
        PageComponent = OfertaDetallada;
        break;
    case "experiencies":
        PageComponent = ExperienciaDetallada;
        break;
    case "diari":
        PageComponent = DiariDetallat;
        break;
    default:
        break;
}
---
<Layout globalData={globalData}>
    {PageComponent ? (
        <PageComponent 
            pageData={pageData} 
            detailedData={detailedData} 
            globalData={globalData} 
        />
    ) : (
        <div>Page not found</div>
    )}
</Layout>
---
// src/pages/[lang]/[slug].astro
import Layout from "@layouts/Layout.astro";
import Acollida from "@components/pages/Acollida.astro";
import Assessories from "@components/pages/Assessories.astro";
import Baumann from "@components/pages/Baumann.astro";
import DiarisVoluntaries from "@components/pages/DiarisVoluntaries.astro";
import Enviament from "@components/pages/Enviament.astro";
import ErasmusExperiencies from "@components/pages/ErasmusExperiencies.astro";
import ExperienciesPi from "@components/pages/ExperienciesPi.astro";
import Experiencies from "@components/pages/Experiencies.astro";
import Formacions from "@components/pages/Formacions.astro";
import Greenfluencers from "@components/pages/Greenfluencers.astro";
import Home from "@components/pages/Home.astro";
import IntercanvisJuvenil from "@components/pages/IntercanvisJuvenil.astro";
import MentorVoluntaries from "@components/pages/MentorVoluntaries.astro";
import OcellFoc from "@components/pages/OcellFoc.astro";
import Ofertes from "@components/pages/Ofertes.astro";
import Playground from "@components/pages/Playground.astro";
import ProjectesPassats from "@components/pages/ProjectesPassats.astro";
import QueEs from "@components/pages/QueEs.astro";
import QueFem from "@components/pages/QueFem.astro";
import QuiSom from "@components/pages/QuiSom.astro";
import RadioVibria from "@components/pages/RadioVibria.astro";
import Refore from "@components/pages/Refore.astro";
import Sending from "@components/pages/Sending.astro";
import Volunteer from "@components/pages/Volunteer.astro";
import { extractLang } from "@wp/extractLang.js";
import { 
    getImageInfo,
    getSlidesInfo,
    getExperienciesInfo,
    getOfertesInfo,
    getEnviamentInfo,
    getDiarisVoluntariesInfo,
    getExperienciesErasmusInfo,
    getIntercanvisJuvenilInfo,
    getQuiSomInfo,
    getVolunteerInfo,
    getAllSlidesInfo,
    getAllOfertesInfo,
    getAllExperienciesInfo,
    getAllExperienciesErasmusInfo,
    getAllQuiSomInfo,
    getAllDiarisInfo,
    getAllVolunteersInfo
} from "@wp/index.js";
import { getGlobalData, getAllPages } from "@wp/sharedBuildData.js";

export async function getStaticPaths() {
    const languages = ["ca", "es", "en"];
    
    console.log("🚀 [SLUG] Building main pages...");
    const startTime = Date.now();
    
    // ============================================
    // ✅ OPTIMIZACIÓN 2: Datos globales cacheados
    // ============================================
    const globalData = await getGlobalData();
    console.log(`✅ [${Date.now() - startTime}ms] Global data ready`);
    
    console.log('📡 [PRE-LOAD] Pre-loading ALL complex page data...');
    const preLoadStart = Date.now();
    
    await Promise.all([
      getAllSlidesInfo(),
      getAllOfertesInfo(),
      getAllExperienciesInfo(),
      getAllExperienciesErasmusInfo(),
      getAllQuiSomInfo(),
      getAllDiarisInfo(),
      getAllVolunteersInfo()
    ]);
    
    console.log(`✅ [${Date.now() - preLoadStart}ms] Complete pre-load finished`);
    
    // ============================================
    // ✅ OPTIMIZACIÓN 3: Páginas cacheadas
    // ============================================
    const allPages = await getAllPages();
    
    // ✅ FILTRAR: Solo páginas SIN categoría (van a [slug])
    const mainPages = allPages.filter(page => !page.acf?.categoria);
    console.log(`✅ [${Date.now() - startTime}ms] Found ${mainPages.length} main pages`);
    
    // ============================================
    // PASO 3: Resolver datos específicos por página
    // ============================================
    console.log("📡 Resolving page-specific data in parallel...");
    
    const pathsPromises = mainPages.map(async (page) => {
        const extracted = extractLang(page.slug);
        if (!extracted || !languages.includes(extracted.lang)) {
            return null;
        }
        
        const { lang, baseSlug } = extracted;
        const slugCompleto = page.slug;
        
        let typeSpecificData = {};
        let pageContent = page.content?.rendered || "";
        
        try {
            switch (baseSlug) {
                case 'home': {
                    const difusionImagenes = await getImageInfo(page.acf.difusion_imagen);
                    const slidesRaw = await getSlidesInfo(lang);
                    console.log(`⏱️ home [${lang}] done in ${Date.now() - startTime}ms`);
                    typeSpecificData = { 
                        slides: slidesRaw, 
                        difusionImagenes: difusionImagenes || [] 
                    };
                    break;
                }
                
                case 'experiencies': {
                    const experiencias = await getExperienciesInfo(lang, slugCompleto);
                    console.log(`⏱️ experiencies [${lang}] done in ${Date.now() - startTime}ms`);
                    typeSpecificData = { experiencias: experiencias || [] };
                    break;
                }
                
                case 'ofertes': {
                    const ofertas = await getOfertesInfo(lang);
                    console.log(`⏱️ ofertes [${lang}] done in ${Date.now() - startTime}ms`);
                    typeSpecificData = { ofertas: ofertas || [] };
                    break;
                }
                case 'enviament': {
                    const enviamentData = await getEnviamentInfo(lang, slugCompleto);
                    console.log(`⏱️ enviament [${lang}] done in ${Date.now() - startTime}ms`);
                    typeSpecificData = enviamentData;
                    break;
                }
                case 'diaris-voluntaries': {
                    // Llamamos a la función que creamos en config.js/index.js
                    const diarisDataArray = await getDiarisVoluntariesInfo(lang, slugCompleto);
                    // ✅ CORRECCIÓN: La función retorna un array con 1 elemento, lo desestructuramos
                    const diarisData = diarisDataArray[0] || {};
                    // Guardamos los años y los diarios en typeSpecificData
                    // para que lleguen como props al componente final
                    typeSpecificData = { 
                        anys: diarisData.anys || [], 
                        diaris: diarisData.diaris || [] 
                    };
                    // También guardamos el pageContent si existe
                    if (diarisData.pageContent) {
                        pageContent = diarisData.pageContent;
                    }
                    break;
                }
                
                case 'erasmus-experiencies': {
                    const experiencias = await getExperienciesErasmusInfo(lang);
                    console.log(`⏱️ erasmus-experiencies [${lang}] done in ${Date.now() - startTime}ms`);
                    typeSpecificData = { experiencias: experiencias || [] };
                    break;
                }
                
                case 'intercanvis-juvenil': {
                    const intercanvisData = await getIntercanvisJuvenilInfo(lang, slugCompleto);
                    const data = intercanvisData[0] || {};
                    console.log(`⏱️ intercanvis-juvenil [${lang}] done in ${Date.now() - startTime}ms`);
                    typeSpecificData = { 
                        experiencias: data.experiencesErasmus || [] 
                    };
                    if (data.pageContent) {
                        pageContent = data.pageContent;
                    }
                    break;
                }
                
                case 'qui-som': {
                    const quiSomData = await getQuiSomInfo(lang, slugCompleto);
                    const data = quiSomData[0] || {};
                    console.log(`⏱️ qui-som [${lang}] done in ${Date.now() - startTime}ms`);
                    typeSpecificData = { 
                        teamMembers: data.quisom || [],           
                        voluntaries: data.voluntaries || [],       
                        pageContent: data.pageContent || '',
                        titol1: data.titol1 || '',
                        titol2: data.titol2 || '',
                        text: data.text || '',
                        buttonText: data.buttonText || '',
                        buttonUrl: data.buttonUrl || '#'
                    };
                    break;
                }
                
                case 'volunteer': {
                    const volunteerDataArray = await getVolunteerInfo(lang, slugCompleto);
                    const volunteerData = volunteerDataArray[0] || {};
                    console.log(`⏱️ volunteer [${lang}] done in ${Date.now() - startTime}ms`);
                    typeSpecificData = { 
                        cards: volunteerData.cards || [],
                        acf: volunteerData.acf || {}
                    };
                    if (volunteerData.pageContent) {
                        pageContent = volunteerData.pageContent;
                    }
                    break;
                }
                
                default:
                    // Páginas simples sin datos extra
                    break;
            }
        } catch (error) {
            console.error(`❌ Error resolving data for ${baseSlug}:`, error.message);
            typeSpecificData = {};
        }
        
        return {
            params: { lang, slug: baseSlug },
            props: {
                globalData: globalData[lang],
                pageData: {
                    acf: page.acf,
                    content: pageContent,
                    slug: baseSlug
                },
                typeSpecificData
            }
        };
    });
    
    const paths = (await Promise.all(pathsPromises)).filter(Boolean);
    
    const duration = ((Date.now() - startTime) / 1000).toFixed(2);
    
    console.log(`✅ [SLUG] Build completed: ${paths.length} pages in ${duration}s`);
    console.log(`⚡ Average: ${(duration / paths.length).toFixed(2)}s per page`);
    
    return paths;
}

const { globalData, pageData, typeSpecificData } = Astro.props;

let PageComponent;

switch (Astro.params.slug) {
    case "acollida": PageComponent = Acollida; break;
    case "assessories": PageComponent = Assessories; break;
    case "baumann": PageComponent = Baumann; break;
    case "diaris-voluntaries": PageComponent = DiarisVoluntaries; break;
    case "enviament": PageComponent = Enviament; break;
    case "erasmus-experiencies": PageComponent = ErasmusExperiencies; break;
    case "experiencies-pi": PageComponent = ExperienciesPi; break;
    case "experiencies": PageComponent = Experiencies; break;
    case "formacions": PageComponent = Formacions; break;
    case "greenfluencers": PageComponent = Greenfluencers; break;
    case "home": PageComponent = Home; break;
    case "intercanvis-juvenil": PageComponent = IntercanvisJuvenil; break;
    case "mentor-voluntaries": PageComponent = MentorVoluntaries; break;
    case "ocell-foc": PageComponent = OcellFoc; break;
    case "ofertes": PageComponent = Ofertes; break;
    case "playground": PageComponent = Playground; break;
    case "projectes-passats": PageComponent = ProjectesPassats; break;
    case "que-es": PageComponent = QueEs; break;
    case "que-fem": PageComponent = QueFem; break;
    case "qui-som": PageComponent = QuiSom; break;
    case "radio-vibria": PageComponent = RadioVibria; break;
    case "refore": PageComponent = Refore; break;
    case "sending": PageComponent = Sending; break;
    case "volunteer": PageComponent = Volunteer; break;
    default: break;
}
---
<Layout globalData={globalData}>
    {PageComponent ? (
        <PageComponent 
            pageData={pageData} 
            typeSpecificData={typeSpecificData} 
            globalData={globalData} 
        />
    ) : (
        <div>Page not found</div>
    )}
</Layout>